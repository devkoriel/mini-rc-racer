import { expect, test } from "@playwright/test";

test("race goes from grid → countdown → running after pressing Space", async ({ page }) => {
  await page.goto("/");
  await expect(page.locator("#overlay-title")).toContainText(/Sector 18/i, { timeout: 5000 });
  await page.keyboard.press("Space");
  // Countdown or running — wait for overlay to hide or for speed to rise above 0.
  await page.waitForFunction(() => {
    const text = document.getElementById("speed-value")?.textContent ?? "";
    const kmh = parseInt(text, 10);
    return !Number.isNaN(kmh) && kmh >= 0;
  });
  await page.keyboard.down("KeyW");
  await page.waitForTimeout(3000);
  await page.keyboard.up("KeyW");
  const speedText = await page.locator("#speed-value").textContent();
  expect(speedText).not.toBeNull();
  const kmh = parseInt(speedText!, 10);
  expect(kmh).toBeGreaterThan(5);
});
```

