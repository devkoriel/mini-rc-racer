- [ ] **Step 3: Implement**

Content of `src/render/prop-instancer.ts`:

```typescript
import * as THREE from "three";

type PropId = "mailbox" | "bin" | "cone" | "fence-post" | "tree-conifer" | "street-light" | "parked-sedan" | "house-block";

interface InstanceAccumulator {
  readonly geometry: THREE.BufferGeometry;
  readonly material: THREE.Material;
  readonly transforms: Array<{ position: [number, number, number]; rotation: number; scale: number }>;
}

const SCALE_BUCKETS: Record<"small" | "medium" | "large", number> = {
  small: 0.9,
  medium: 1.0,
  large: 1.1
};

const makePrototype = (propId: PropId): { geometry: THREE.BufferGeometry; material: THREE.Material } => {
  switch (propId) {
    case "mailbox": {
      const geometry = new THREE.BoxGeometry(0.15, 0.3, 0.25);
      const material = new THREE.MeshStandardMaterial({ color: 0x5a5450, roughness: 0.85 });
      return { geometry, material };
    }
    case "bin": {
      const geometry = new THREE.CylinderGeometry(0.18, 0.2, 0.5, 12);
      const material = new THREE.MeshStandardMaterial({ color: 0x303432, roughness: 0.7 });
      return { geometry, material };
    }
    case "cone": {
      const geometry = new THREE.ConeGeometry(0.12, 0.32, 10);
      const material = new THREE.MeshStandardMaterial({ color: 0xd35a1a, roughness: 0.6 });
      return { geometry, material };
    }
    case "fence-post": {
      const geometry = new THREE.BoxGeometry(0.08, 0.6, 0.08);
      const material = new THREE.MeshStandardMaterial({ color: 0x9a6e3c, roughness: 0.92 });
      return { geometry, material };
    }
    case "tree-conifer": {
      const geometry = new THREE.ConeGeometry(0.6, 1.6, 12);
      const material = new THREE.MeshStandardMaterial({ color: 0x3a7a48, roughness: 1.0 });
      return { geometry, material };
    }
    case "street-light": {
      const geometry = new THREE.BoxGeometry(0.08, 1.6, 0.08);
      const material = new THREE.MeshStandardMaterial({ color: 0x7a7a7a, roughness: 0.6 });
      return { geometry, material };
    }
    case "parked-sedan": {
      const geometry = new THREE.BoxGeometry(1.9, 0.6, 0.8);
      const material = new THREE.MeshStandardMaterial({ color: 0x184468, roughness: 0.5, metalness: 0.2 });
      return { geometry, material };
    }
    case "house-block": {
      const geometry = new THREE.BoxGeometry(4, 2.2, 3);
      const material = new THREE.MeshStandardMaterial({ color: 0xc06a4a, roughness: 0.9 });
      return { geometry, material };
    }
  }
};

export interface PropInstancer {
  addInstance: (propId: PropId, position: [number, number, number], rotation: number, scaleBucket: keyof typeof SCALE_BUCKETS) => void;
  build: () => THREE.Group;
}

export const createPropInstancer = (): PropInstancer => {
  const buckets = new Map<PropId, InstanceAccumulator>();
  const addInstance: PropInstancer["addInstance"] = (propId, position, rotation, scaleBucket) => {
    let bucket = buckets.get(propId);
    if (!bucket) {
      const proto = makePrototype(propId);
      bucket = { geometry: proto.geometry, material: proto.material, transforms: [] };
      buckets.set(propId, bucket);
    }
    bucket.transforms.push({ position, rotation, scale: SCALE_BUCKETS[scaleBucket] });
  };
  const build = (): THREE.Group => {
    const group = new THREE.Group();
    group.name = "props";
    const matrix = new THREE.Matrix4();
    for (const [propId, bucket] of buckets) {
      const instanced = new THREE.InstancedMesh(bucket.geometry, bucket.material, bucket.transforms.length);
      instanced.name = `prop-${propId}`;
      for (let i = 0; i < bucket.transforms.length; i += 1) {
        const { position, rotation, scale } = bucket.transforms[i];
        matrix.makeRotationY(rotation).setPosition(position[0], position[1], position[2]);
        matrix.scale(new THREE.Vector3(scale, scale, scale));
        instanced.setMatrixAt(i, matrix);
      }
      instanced.instanceMatrix.needsUpdate = true;
      group.add(instanced);
    }
    return group;
  };
  return { addInstance, build };
};
```

