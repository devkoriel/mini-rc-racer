```typescript
import * as THREE from "three";

export interface CarVisualParts {
  readonly group: THREE.Group;
  readonly chassis: THREE.Mesh;
  readonly wheels: readonly THREE.Mesh[];
  readonly antenna: THREE.Mesh;
  readonly boostGlow: THREE.Mesh;
}

export interface CarStyle {
  readonly primaryColor: string;
  readonly secondaryColor: string;
}

export const createCarMesh = (style: CarStyle): CarVisualParts => {
  const group = new THREE.Group();
  group.name = "car";

  const chassisGeom = new THREE.BoxGeometry(0.6, 0.24, 1.0);
  const chassisMat = new THREE.MeshStandardMaterial({
    color: new THREE.Color(style.primaryColor),
    roughness: 0.45,
    metalness: 0.35
  });
  const chassis = new THREE.Mesh(chassisGeom, chassisMat);
  chassis.position.y = 0.18;
  chassis.castShadow = true;
  group.add(chassis);

  const cabinGeom = new THREE.BoxGeometry(0.46, 0.18, 0.5);
  const cabinMat = new THREE.MeshStandardMaterial({
    color: new THREE.Color(style.secondaryColor),
    roughness: 0.4,
    metalness: 0.1
  });
  const cabin = new THREE.Mesh(cabinGeom, cabinMat);
  cabin.position.set(0, 0.36, -0.05);
  group.add(cabin);

  const wheelGeom = new THREE.CylinderGeometry(0.12, 0.12, 0.08, 16);
  wheelGeom.rotateZ(Math.PI / 2);
  const wheelMat = new THREE.MeshStandardMaterial({ color: 0x1a1a1a, roughness: 0.8 });
  const wheelPositions: Array<[number, number, number]> = [
    [-0.3, 0.12, 0.38],
    [0.3, 0.12, 0.38],
    [-0.3, 0.12, -0.38],
    [0.3, 0.12, -0.38]
  ];
  const wheels = wheelPositions.map(([x, y, z]) => {
    const wheel = new THREE.Mesh(wheelGeom, wheelMat);
    wheel.position.set(x, y, z);
    wheel.castShadow = true;
    group.add(wheel);
    return wheel;
  });

  const antennaGeom = new THREE.CylinderGeometry(0.005, 0.005, 0.5, 6);
  const antennaMat = new THREE.MeshStandardMaterial({ color: 0x222222, roughness: 0.6 });
  const antenna = new THREE.Mesh(antennaGeom, antennaMat);
  antenna.position.set(-0.2, 0.55, -0.3);
  group.add(antenna);

  const glowGeom = new THREE.SphereGeometry(0.18, 16, 16);
  const glowMat = new THREE.MeshBasicMaterial({ color: 0xffc84a, transparent: true, opacity: 0.0 });
  const boostGlow = new THREE.Mesh(glowGeom, glowMat);
  boostGlow.position.set(0, 0.18, -0.6);
  group.add(boostGlow);

  return { group, chassis, wheels, antenna, boostGlow };
};

export const setCarBoostGlow = (parts: CarVisualParts, intensity: number): void => {
  const material = parts.boostGlow.material as THREE.MeshBasicMaterial;
  material.opacity = Math.max(0, Math.min(1, intensity));
};
```

