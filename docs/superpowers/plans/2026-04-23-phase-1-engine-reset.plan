- [ ] **Step 2: Write perf test**

Content of `e2e/perf.spec.ts`:

```typescript
import { expect, test } from "@playwright/test";

test("sustained frame time under 20ms p99 over 3 seconds", async ({ page }) => {
  await page.goto("/");
  await page.keyboard.press("Space");
  const samples = await page.evaluate(async () => {
    const out: number[] = [];
    let previous = performance.now();
    return new Promise<number[]>((resolve) => {
      let frames = 0;
      const tick = (now: number) => {
        out.push(now - previous);
        previous = now;
        frames += 1;
        if (frames >= 180) resolve(out); else requestAnimationFrame(tick);
      };
      requestAnimationFrame((t) => { previous = t; requestAnimationFrame(tick); });
    });
  });
  samples.sort((a, b) => a - b);
  const p99 = samples[Math.floor(samples.length * 0.99)];
  expect(p99).toBeLessThan(20);
});
```

